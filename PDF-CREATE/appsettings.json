{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Rendering": {
    "Assets": {
      "Root": "Assets",
      "Fonts": {
        "Root": "Fonts",
        "Families": {
          "Default": [
            "B_NAZANIN/B-NAZANIN.TTF",
            "DANA/Dana-FaNum-Regular.ttf"
          ]
        }
      },
      "Images": {
        "Root": "Images",
        "Logos": {
          "Primary": "logo.png"
        }
      }
    },
    "Outputs": {
      "Pdf": {
        "Defaults": {
          "FontFamily": "Default",
          "Logo": "Primary"
        }
      }
    }
  }

}

